# /etc/jnpt-updater.d/google-reporting.conf; root-owned regular file, 0600/0644.
IMAGE_REPO=ghcr.io/januaport/google-reporting
COMPOSE_FILE=/opt/jnpt/plugins/google-reporting/docker-compose.yml
SERVICE=google-reporting
ENV_FILE=/opt/jnpt/plugins/google-reporting/.env
ENV_KEY=JNPT_GOOGLE_REPORTING_IMAGE
HEALTH_DOCKER=1
# Vorbedingungen: config.json und BEIDE runtime-key-Dateien, die das Gateway nach
# dem Eintragen in der Basis-Einrichtung ablegt (Stellen plugin-google-reporting
# und plugin-google-reporting-google). Fehlt eine, bucht der Aktuator
# `unprovisioned` statt `failed`.
REQUIRE=/opt/jnpt/plugins/google-reporting/config.json:/run/jnpt/plugins/google-reporting/runtime-key:/run/jnpt/plugins/google-reporting-google/runtime-key
# DATA_DIRS intentionally absent: no report persistence.
