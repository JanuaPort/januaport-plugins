# jnpt-bing-webmaster-key.service — erzeugt den Bing-Webmaster-Beisteller neu,
# wenn sich einer seiner Laufzeit-Schlüssel geändert hat oder nach dem Boot
# angekommen ist (#1292).
#
# Geweckt wird die Unit von jnpt-bing-webmaster-key.path. Sie entscheidet
# nichts und sie liest keinen Schlüssel — sie erzeugt den Container neu, mehr nicht.
#
# Von Hand auslösen:  systemctl start jnpt-bing-webmaster-key.service
# Mitlesen:           journalctl -u jnpt-bing-webmaster-key.service -f
#
# ⚠️ FESTE ABLAGE: /opt/jnpt/plugins/bing-webmaster/docker-compose.yml, die
# `.env` mit dem Image-Pin daneben (wie jnpt-plugin-key@.service des Produkts).

[Unit]
Description=Startet den JanuaPort-Beisteller bing-webmaster nach einem Schlüsselwechsel neu
Documentation=https://github.com/JanuaPort/januaport/blob/main/deploy/tunnel/CLAUDE.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot

WorkingDirectory=/opt/jnpt/plugins/bing-webmaster
# ⚠️ `--force-recreate` ist nicht optional: `up -d` allein sähe ein
# unverändertes Image mit unveränderter Konfiguration und täte NICHTS — der
# Dienst liefe mit dem alten Schlüssel weiter.
ExecStart=/usr/bin/docker compose -f /opt/jnpt/plugins/bing-webmaster/docker-compose.yml up -d --force-recreate

TimeoutStartSec=120

# ── Härtung (1:1 wie jnpt-plugin-key@.service) ──────────────────────────────
# Der Dienst braucht den Docker-Socket und läuft deshalb als root. Alles andere
# wird zugemacht. ProtectHome=read-only statt yes: Zugangsdaten einer privaten
# Registry liegen in /root/.docker/config.json (Lehre #509).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

# Protokolliert wird ausschließlich, was `docker compose` sagt — die
# Schlüsselwerte werden hier nie gelesen.

# ⚠️ Bewusst KEIN [Install]-Abschnitt: Diese Unit wird geweckt, nie aktiviert.
