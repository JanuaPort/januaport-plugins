# Beispiel für /opt/jnpt/plugins/script-runner/.env (JanuaPort/januaport#928).
# Liegt neben docker-compose.yml; root:root, 0644.
#
# JNPT_SCRIPT_RUNNER_IMAGE schreibt der Aktuator (ENV_KEY im Deskriptor) als
# ghcr.io/januaport/script-runner@<Digest aus dem signierten Katalog> — nicht
# von Hand setzen.

# Runtime der Sandbox. Standard runc mit Härtung (Seccomp-Profil, AppArmor
# docker-default, keine Capabilities).
JNPT_SCRIPT_RUNNER_RUNTIME=runc
# Wandzeitdecke des vermittlers: 1..86400 ganze Sekunden, Standard 86400.
# Wird als max_wall_s gemeldet und selbst eingehalten (#1040 Schritt L).
JNPT_SCRIPT_RUNNER_MAX_WALL_S=86400
# Mit gVisor: erst den eigenen Runtime-Eintrag runsc-jnpt in
# /etc/docker/daemon.json anlegen (deploy/daemon.json.example), dann:
#JNPT_SCRIPT_RUNNER_RUNTIME=runsc-jnpt
